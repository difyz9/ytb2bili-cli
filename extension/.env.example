# 分析服务器配置
VITE_ANALYTICS_SERVER_URL=http://localhost:8080
VITE_ANALYTICS_PRODUCT_NAME=ytb2bili-extension
VITE_ANALYTICS_DEBUG=true

# 后端服务器配置
VITE_BACKEND_URL=https://stage.api2key.com

# 平台 API 地址
VITE_MEMBERSHIP_URL=https://your-api-domain.com/api/v1

# ytb2bili-web 前台地址，用于网页登录后同步扩展会话
VITE_WEB_APP_URL=https://your-web-domain.com

# API 认证配置
VITE_APP_ID=your_app_id_here
VITE_PROJECT_ID=
VITE_APP_SECRET=your_app_secret_here

# Cookies 加密密钥（32位字符）
VITE_COOKIES_ENCRYPT_KEY=your_32_char_encryption_key_here
