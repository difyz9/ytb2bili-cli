// 辅助函数：解析版本号
@NonCPS
def parseVersion(String tag) {
    def matcher = tag =~ /^v?(\d+)\.(\d+)\.(\d+)(-.*)?$/
    if (matcher.matches()) {
        return [
            major: matcher[0][1].toInteger(),
            minor: matcher[0][2].toInteger(),
            patch: matcher[0][3].toInteger(),
            suffix: matcher[0][4] ?: ''
        ]
    }
    return [major: 0, minor: 0, patch: 0, suffix: '']
}

pipeline {
    agent any
    
    parameters {
        string(name: 'FILES_DIR', defaultValue: 'dist', description: '二进制文件所在目录（相对路径或绝对路径）')
        string(name: 'FILE_PATTERN', defaultValue: '*.zip', description: '文件匹配模式（如: *.zip, *.tar.gz, *）')
        string(name: 'VERSION', defaultValue: '', description: 'Release 版本号（留空则自动递增，如: 1.0.1）')
        booleanParam(name: 'AUTO_INCREMENT', defaultValue: true, description: '自动递增版本号（检查 GitHub 已有版本）')
        booleanParam(name: 'PRERELEASE', defaultValue: false, description: '标记为预发布版本')
        text(name: 'RELEASE_NOTES', defaultValue: '', description: 'Release 说明（留空则使用默认模板）')
    }
    
    environment {
        PATH = "/opt/homebrew/bin:${env.PATH}"
        GITHUB_REPO = 'difyz9/ytb2bili-extension'  // 目标 GitHub 仓库
        GITHUB_TOKEN = credentials('github-token')  // Jenkins 中配置的 GitHub Token
    }
    
    stages {
        stage('Prepare Version') {
            steps {
                script {
                    echo "Preparing release version..."
                    
                    if (params.VERSION) {
                        // 使用用户指定的版本
                        env.BUILD_TAG = params.VERSION.startsWith('v') ? params.VERSION : "v${params.VERSION}"
                        env.VERSION = env.BUILD_TAG.replaceAll('^v', '')
                        echo "Using specified version: ${env.BUILD_TAG}"
                    } else {
                        // 自动生成版本号
                        env.BUILD_TAG = "v1.0.0"
                        env.VERSION = "1.0.0"
                        echo "Using default version: ${env.BUILD_TAG}"
                    }
                    
                    // 如果启用自动递增，检查 GitHub 上是否已存在
                    if (params.AUTO_INCREMENT) {
                        def maxAttempts = 100
                        def attempts = 0
                        
                        while (attempts < maxAttempts) {
                            def checkResult = sh(
                                script: """
                                    export GH_TOKEN="${env.GITHUB_TOKEN}"
                                    if command -v gh &> /dev/null; then
                                        gh release view ${env.BUILD_TAG} --repo ${env.GITHUB_REPO} &> /dev/null && echo 'exists' || echo 'not_exists'
                                    else
                                        echo 'not_exists'
                                    fi
                                """,
                                returnStdout: true
                            ).trim()
                            
                            if (checkResult == 'exists') {
                                echo "Version ${env.BUILD_TAG} already exists on GitHub, incrementing..."
                                def versionParts = parseVersion(env.BUILD_TAG)
                                env.BUILD_TAG = "v${versionParts.major}.${versionParts.minor}.${versionParts.patch + 1}${versionParts.suffix}"
                                env.VERSION = env.BUILD_TAG.replaceAll('^v', '')
                                attempts++
                            } else {
                                echo "Version ${env.BUILD_TAG} is available"
                                break
                            }
                        }
                        
                        if (attempts >= maxAttempts) {
                            error("Reached maximum attempts to find an available version")
                        }
                    }
                    
                    echo "Final version: ${env.BUILD_TAG}"
                }
            }
        }
        
        stage('Validate Files') {
            steps {
                script {
                    echo "Validating files in ${params.FILES_DIR}..."
                    
                    // 检查目录是否存在
                    def dirExists = sh(
                        script: "test -d '${params.FILES_DIR}' && echo 'yes' || echo 'no'",
                        returnStdout: true
                    ).trim()
                    
                    if (dirExists != 'yes') {
                        error("Directory not found: ${params.FILES_DIR}")
                    }
                    
                    // 列出匹配的文件
                    def filesList = sh(
                        script: "ls -1 ${params.FILES_DIR}/${params.FILE_PATTERN} 2>/dev/null || echo ''",
                        returnStdout: true
                    ).trim()
                    
                    if (!filesList) {
                        error("No files found matching pattern: ${params.FILES_DIR}/${params.FILE_PATTERN}")
                    }
                    
                    echo "Found files to upload:"
                    sh "ls -lh ${params.FILES_DIR}/${params.FILE_PATTERN}"
                    
                    // 保存文件列表
                    env.FILES_TO_UPLOAD = filesList.split('\n').join(' ')
                }
            }
        }
        
        stage('Archive Artifacts') {
            steps {
                script {
                    echo "Archiving artifacts..."
                    archiveArtifacts artifacts: "${params.FILES_DIR}/${params.FILE_PATTERN}", fingerprint: true
                }
            }
        }
        
        stage('Create GitHub Release') {
            steps {
                script {
                    echo "Creating GitHub release ${env.BUILD_TAG}..."
                    
                    // 准备 Release Notes
                    def releaseBody = params.RELEASE_NOTES ?: """## 🚀 Release ${env.BUILD_TAG}

### 📦 Binary Release

This release contains pre-built binary files.

### 📋 Build Information
- Version: ${env.VERSION}
- Build Number: ${env.BUILD_NUMBER}
- Build Time: ${new Date().format('yyyy-MM-dd HH:mm:ss')}

### 📥 Download
Download the appropriate file for your platform from the assets below.
"""
                    
                    sh """
                        export GH_TOKEN="${GITHUB_TOKEN}"
                        
                        # 安装 GitHub CLI (如果未安装)
                        if ! command -v gh &> /dev/null; then
                            echo "Installing GitHub CLI..."
                            if command -v brew &> /dev/null; then
                                brew install gh
                            else
                                echo "Error: GitHub CLI not found. Please install it manually."
                                exit 1
                            fi
                        fi

                        # 检查仓库是否为空
                        if ! gh api repos/${GITHUB_REPO} --jq '.size' > /dev/null 2>&1 || [ "\$(gh api repos/${GITHUB_REPO} --jq '.size')" = "0" ]; then
                            echo "Repository is empty, initializing with README..."
                            
                            INIT_DIR=\$(mktemp -d)
                            cd "\$INIT_DIR"
                            
                            git init
                            git config user.email "jenkins@example.com"
                            git config user.name "Jenkins Build"
                            
                            echo "# Binary Releases" > README.md
                            echo "" >> README.md
                            echo "This repository hosts binary releases." >> README.md
                            echo "" >> README.md
                            echo "## Download" >> README.md
                            echo "Check the [Releases](https://github.com/${GITHUB_REPO}/releases) page for downloads." >> README.md
                            
                            git add README.md
                            git commit -m "Initial commit"
                            git remote add origin "https://${GITHUB_TOKEN}@github.com/${GITHUB_REPO}.git"
                            git branch -M main
                            git push -u origin main --force
                            
                            cd -
                            rm -rf "\$INIT_DIR"
                            
                            echo "Repository initialized successfully"
                        fi

                        # 检查并删除已存在的 release
                        if gh release view ${env.BUILD_TAG} --repo "${env.GITHUB_REPO}" &> /dev/null; then
                            echo "Release ${env.BUILD_TAG} already exists, deleting..."
                            gh release delete ${env.BUILD_TAG} --repo "${env.GITHUB_REPO}" --yes
                        fi

                        # 获取远程 commit
                        REMOTE_COMMIT=\$(gh api repos/${GITHUB_REPO}/git/ref/heads/main --jq '.object.sha' 2>/dev/null || echo "")
                        
                        # 创建 release
                        if [ -z "\$REMOTE_COMMIT" ]; then
                            echo "Creating release without target commit..."
                            gh release create ${env.BUILD_TAG} \
                                --repo "${env.GITHUB_REPO}" \
                                --title "Release ${env.BUILD_TAG}" \
                                --notes '${releaseBody}' \
                                ${params.PRERELEASE ? '--prerelease' : ''} \
                                ${params.FILES_DIR}/${params.FILE_PATTERN}
                        else
                            echo "Creating release targeting commit: \$REMOTE_COMMIT"
                            gh release create ${env.BUILD_TAG} \
                                --repo "${env.GITHUB_REPO}" \
                                --title "Release ${env.BUILD_TAG}" \
                                --notes '${releaseBody}' \
                                --target "\$REMOTE_COMMIT" \
                                ${params.PRERELEASE ? '--prerelease' : ''} \
                                ${params.FILES_DIR}/${params.FILE_PATTERN}
                        fi
                    """
                    
                    echo "GitHub release created successfully!"
                    echo "URL: https://github.com/${env.GITHUB_REPO}/releases/tag/${env.BUILD_TAG}"
                }
            }
        }
    }
    
    post {
        success {
            echo "✅ Release completed successfully!"
            echo "Version: ${env.VERSION}"
            echo "Tag: ${env.BUILD_TAG}"
            echo "Files uploaded from: ${params.FILES_DIR}/${params.FILE_PATTERN}"
        }
        
        failure {
            echo "❌ Release failed!"
        }
        
        always {
            echo "Pipeline execution completed"
        }
    }
}
